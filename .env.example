# 多端同步（Phase 5）用到的 Supabase 项目信息。
# 复制这个文件为 .env（.env 已被 .gitignore 排除，不会进仓库），填入真实值。
#
# 这两个值本来就设计给前端公开使用（Supabase "publishable key"），配合
# Supabase 端的行级权限规则（见 supabase/schema.sql）保证安全，
# 不是需要严格保密的敏感凭据；但仍不直接提交进仓库，保持"仓库里只留占位模板"的习惯。
#
# 未配置这两个值时，应用照常以纯本地模式运行，同步功能自动处于"未配置"状态。

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google 日历（可选）。未配置时设置页显示「未配置」，本地计时不受影响。
#
# 这里要的是番茄钟这个网站的「Web application」客户端 ID
# （本机 GoogleCalendar.json 里 web.client_id 那一串）。
# 飞书排期同步那份 Desktop JSON 是另一个应用，不能给这个网站用。
# 可以在同一个 Google Cloud 项目里再新建一个 Web 客户端：
# - 启用 Google Calendar API（若已为桌面应用启用过，则不用再开一次）
# - 授权的 JavaScript 来源：http://localhost:5173 和 https://toy.viyi.cc
# - 授权重定向 URI：https://toy.viyi.cc 与 http://localhost:5173
# 只需把客户端 ID 填在下面，不要把 client_secret 放进网页。
VITE_GOOGLE_CALENDAR_CLIENT_ID=
